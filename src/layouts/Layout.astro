---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

/* Kürzer als vorher: 181 Zeichen wurden in der Trefferliste abgeschnitten, und
   abgeschnitten wird immer am Ende — also da, wo der Aufruf zum Handeln steht. */
const { title, description = "Ganzheitliches Online-Coaching ab 40: mehr Energie, weniger Bauch, klarer Kopf. Körper, Ernährung und Mindset in einem System." } = Astro.props;

/* Astro.site ist nicht gesetzt, deshalb die Domain fest. Absolute URLs sind bei
   Open Graph Pflicht — ein relativer Pfad wird von WhatsApp und LinkedIn
   ignoriert, und der geteilte Link bleibt ein grauer Kasten. */
const SITE = 'https://www.danielepauli.com';
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = `${SITE}/images/og-cover.jpg`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Favicon (Prometheus-Flamme) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="canonical" href={canonical} />

    <!-- Open Graph. og:url zeigt auf die jeweilige Seite, nicht pauschal auf die
         Startseite — sonst meldet jede geteilte Unterseite sich als Startseite. -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content="Daniele Pauli Coaching" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Calendly -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
  </head>
  <body>
    <!-- Grain Texture Overlay -->
    <div class="grain"></div>

    <!-- Background Gradient Blobs -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="blob blob-orange w-[600px] h-[600px] -top-48 -left-48 opacity-30"></div>
      <div class="blob blob-beige w-[500px] h-[500px] top-1/3 -right-64 opacity-20" style="animation-delay: -5s;"></div>
      <div class="blob blob-amber w-[400px] h-[400px] bottom-0 left-1/4 opacity-25" style="animation-delay: -10s;"></div>
    </div>

    <slot />

    <!-- Floating Survey Button (shows after scroll) -->
    <a
      href="/survey/"
      id="floating-survey-btn"
      class="fixed bottom-6 right-6 z-50 btn-primary glow-orange opacity-0 translate-y-4 transition-all duration-300 pointer-events-none shadow-2xl flex items-center gap-2"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
      </svg>
      Ich 2.0 Check
    </a>

    <!-- Messung: Herkunft merken und Besuch zählen.
         Ohne diese Zahlen gibt Werbung Geld aus, ohne zu zeigen, welcher
         Suchbegriff einen Lead gebracht hat. Kein Cookie, keine Kennung —
         siehe src/lib/visits.ts. -->
    <script>
      import { captureClickSource, listenForCalendlyBooking } from '../lib/tracking';
      import { countVisit } from '../lib/visits';
      captureClickSource();
      countVisit();
      listenForCalendlyBooking();
    </script>

    <!-- Scroll Animation Script -->
    <script>
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      }, observerOptions);

      document.querySelectorAll('[data-animate]').forEach(el => {
        observer.observe(el);
      });

      // Floating button visibility
      const floatingBtn = document.getElementById('floating-survey-btn');
      const isSurveyPage = window.location.pathname.includes('/survey');

      if (floatingBtn && !isSurveyPage) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 500) {
            floatingBtn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            floatingBtn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
          } else {
            floatingBtn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
            floatingBtn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          }
        });
      } else if (floatingBtn && isSurveyPage) {
        floatingBtn.style.display = 'none';
      }
    </script>
  </body>
</html>
