---
// Footer section
---

<footer class="section py-12 border-t border-glass-border">
  <div class="section-container">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <!-- Logo (3× tippen öffnet den Admin-Bereich) -->
      <div>
        <a href="/" id="footer-logo" class="text-xl font-bold text-text-primary select-none">
          Daniele Pauli <span class="gradient-text">Coaching</span>
        </a>
        <p class="text-text-secondary text-sm mt-1">
          Ganzheitliches Coaching für Männer 40+
        </p>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-6">
        <a
          href="https://wa.me/41798675705"
          target="_blank"
          class="text-text-secondary hover:text-orange transition-colors"
        >
          WhatsApp
        </a>
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-booking'))"
          class="text-text-secondary hover:text-orange transition-colors"
        >
          Erstgespräch
        </button>
        <a
          href="/survey"
          class="text-text-secondary hover:text-orange transition-colors"
        >
          Ich 2.0 Check
        </a>
        <!-- Pflichtangaben. Google Ads verlangt für Zielseiten, die
             personenbezogene Daten erheben, eine erreichbare
             Datenschutzerklärung; der „Ich 2.0 Check" erhebt welche. -->
        <a
          href="/impressum/"
          class="text-text-secondary hover:text-orange transition-colors"
        >
          Impressum
        </a>
        <a
          href="/datenschutz/"
          class="text-text-secondary hover:text-orange transition-colors"
        >
          Datenschutz
        </a>
      </div>

      <!-- Copyright -->
      <div class="text-text-secondary text-sm">
        © {new Date().getFullYear()} Daniele Pauli Coaching
      </div>
    </div>
  </div>
</footer>

<!-- Geheimzugang: 3× schnell auf den Footer-Schriftzug tippen → /admin -->
<script>
  const logo = document.getElementById('footer-logo');
  if (logo) {
    let taps = 0;
    let timer;
    logo.addEventListener('click', (e) => {
      e.preventDefault();
      taps++;
      clearTimeout(timer);
      if (taps >= 3) {
        taps = 0;
        window.location.href = '/admin';
        return;
      }
      timer = window.setTimeout(() => { taps = 0; }, 1500);
    });
  }
</script>
