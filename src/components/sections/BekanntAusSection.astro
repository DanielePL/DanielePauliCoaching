---
// "Bekannt aus" — dezenter Medien-/Press-Streifen (echte, verifizierte Credibility).
// Nur Medien-Namen/Logos als Autorität – KEINE Schwerathletik-Bilder.
// Logo nachrüsten: { name, logo: '/images/media/srf.svg' } -> zeigt Bild statt Text.
// url -> macht den Eintrag klickbar (überprüfbar = mehr Vertrauen).
const features = [
  {
    name: 'SRF «Aeschbacher»',
    logo: null,
    note: null,
    url: 'https://www.srf.ch/play/tv/aeschbacher/video/daniele-pauli?urn=urn:srf:video:e7e0233c-d358-4b79-96a5-127bf31eddfd',
  },
  {
    name: 'Strength Wars',
    logo: null,
    note: '3 Mio.+ Views',
    url: null,
  },
];
---

<section class="py-8 sm:py-10 border-y border-glass-border/40" aria-label="Bekannt aus den Medien">
  <div class="section-container">
    <div class="flex flex-col items-center gap-4 sm:gap-5" data-animate>
      <p class="text-xs uppercase tracking-[0.2em] text-text-secondary/60">
        Bekannt aus
      </p>

      <div class="flex flex-wrap items-center justify-center gap-x-5 sm:gap-x-8 gap-y-3">
        {features.map((m, i) => {
          const Inner = (
            <span class="inline-flex items-baseline gap-2 opacity-80 hover:opacity-100 transition-opacity">
              {m.logo ? (
                <img src={m.logo} alt={m.name} class="h-6 md:h-7 w-auto self-center" loading="lazy" />
              ) : (
                <span class="text-text-secondary font-semibold text-lg md:text-xl tracking-wide whitespace-nowrap">{m.name}</span>
              )}
              {m.note && (
                <span class="text-orange/80 text-xs font-medium whitespace-nowrap">{m.note}</span>
              )}
            </span>
          );
          return (
            <Fragment>
              {i > 0 && <span class="hidden sm:block w-px h-5 bg-glass-border" aria-hidden="true"></span>}
              {m.url ? (
                <a href={m.url} target="_blank" rel="noopener noreferrer" class="inline-flex">{Inner}</a>
              ) : Inner}
            </Fragment>
          );
        })}
      </div>
    </div>
  </div>
</section>
