---
// Hero Section — Neukonzept: ganzheitliches Coaching ab 40
// Siehe "konzept 2026.md" Abschnitt 4 (ABC-Hybrid)
// Hintergrundfoto: Schweizermeisterschaft 2021, © Roland Riesen Photography
---

<section class="min-h-screen flex items-center relative overflow-hidden">
  <!-- Hintergrundfoto (S/W) -->
  <div class="absolute inset-0 pointer-events-none">
    <img
      src="/images/hero-daniele.webp"
      alt=""
      fetchpriority="high"
      class="w-full h-full object-cover"
      style="object-position: 32% 28%;"
    />
    <!-- Overlays: links lesbar, unten Übergang in den Seitenhintergrund -->
    <div class="absolute inset-0 bg-gradient-to-l from-background via-background/75 to-background/25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/25 to-background/50"></div>
  </div>

  <!-- Navigation -->
  <nav class="absolute top-0 left-0 right-0 z-20 p-4 sm:p-6 flex justify-between items-center gap-3">
    <a href="/" class="text-base sm:text-xl font-bold text-text-primary leading-tight whitespace-nowrap">
      Daniele Pauli <span class="gradient-text">Coaching</span>
    </a>
    <a href="/survey/" class="btn-secondary !w-auto text-xs sm:text-sm py-1.5 sm:py-2 px-3 sm:px-4 flex items-center gap-1.5 sm:gap-2 flex-shrink-0 whitespace-nowrap">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
      </svg>
      Ich 2.0 Check
    </a>
  </nav>

  <!-- Main Content: linksbündig auf Desktop, zentriert auf Mobile -->
  <div class="section-container relative z-10 px-6 w-full">
    <div class="max-w-2xl mx-auto md:mr-0 md:ml-auto text-center md:text-left pt-28 pb-20">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 glass px-4 py-2 rounded-full mb-8 animate-fade-up">
        <span class="w-2 h-2 bg-orange rounded-full animate-pulse"></span>
        <span class="text-sm text-text-secondary">Ganzheitliches Online-Coaching ab 40</span>
      </div>

      <!-- Headline -->
      <h1 class="heading-xl mb-6 animate-fade-up delay-100">
        <span class="text-text-primary">Wieder</span>
        <span class="gradient-text text-glow">voll da.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-xl md:text-2xl text-text-secondary mb-5 animate-fade-up delay-200">
        Mehr Energie, weniger Bauch, klarer Kopf. Ohne Crash-Diät,
        ohne stundenlanges Cardio, ohne dich zu verbiegen.
      </p>

      <!-- Empathie-Zeile -->
      <p class="text-base md:text-lg text-text-secondary/70 italic mb-10 animate-fade-up delay-300">
        Müdigkeit ist kein Charakterfehler. Sie ist ein Signal.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start animate-fade-up delay-400">
        <a
          href="/survey/"
          class="btn-primary glow-orange-hover group"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
          Mach den Ich-2.0-Check
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-booking'));return false;"
          class="btn-secondary"
        >
          Kostenloses Erstgespräch
        </button>
      </div>

      <!-- Mikro-Trust-Zeile -->
      <p class="text-sm text-text-secondary/60 mt-6 animate-fade-up delay-400">
        2-Minuten-Check · unverbindlich · kostenlos
      </p>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce z-10">
    <svg class="w-6 h-6 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>

  <!-- Quote -->
  <div class="absolute bottom-8 left-8 max-w-xs hidden md:block z-10">
    <p class="text-text-secondary/60 italic text-sm">
      "Stark sein heisst: ein Leben lang voll da sein."
    </p>
  </div>

  <!-- Bildnachweis -->
  <div class="absolute bottom-3 right-4 hidden md:block z-10">
    <p class="text-text-secondary/30 text-[10px] tracking-wide">© Roland Riesen Photography</p>
  </div>
</section>
