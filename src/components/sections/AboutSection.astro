---
// About Daniele section
const achievements = [
  "Optimales Zeitinvestment in dein Training und deine Gesundheit. Du fühlst dich wacher, fitter und stärker als vor zehn Jahren.",
  "20+ Jahre Erfahrung, vom Leistungssport bis zum Marathon. Ich kenne den Körper aus jeder Perspektive, nicht nur die Hantel.",
  "Für alle ab 40, ob angestellt, selbstständig oder mitten im Familienleben.",
  "Ganzheitlich: Körper, Kopf, Ernährung & Lifestyle, abgestimmt auf deinen Alltag."
];
---

<section class="section" id="about">
  <div class="section-container">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Content -->
      <div data-animate>
        <h2 class="heading-lg mb-8">
          Ein Ziel: dass du wieder <span class="gradient-text">voll da</span> bist.
        </h2>

        <ul class="space-y-4 mb-8">
          {achievements.map((achievement) => (
            <li class="flex items-start gap-3 text-text-secondary">
              <span class="w-2 h-2 bg-orange rounded-full mt-2 flex-shrink-0"></span>
              {achievement}
            </li>
          ))}
        </ul>
      </div>

      <!-- Card -->
      <div class="relative mb-10 sm:mb-0" data-animate style="transition-delay: 200ms">
        <!-- Background accent -->
        <div class="absolute -top-4 -left-4 w-full h-full bg-orange/10 rounded-3xl transform rotate-3"></div>

        <!-- Main card -->
        <div class="glass-card overflow-hidden relative">
          <!-- Coaching-Foto: Daniele arbeitet Hands-on mit einem Athleten -->
          <div class="aspect-[3/2] bg-gradient-to-b from-surface to-background relative overflow-hidden">
            <img
              src="/images/daniele-training.webp"
              alt="Daniele Pauli beim Hands-on-Coaching mit einem Athleten"
              class="w-full h-full object-cover"
              loading="lazy"
            />

            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent"></div>
          </div>

          <!-- Info -->
          <div class="p-6 sm:pr-44 lg:pr-48 relative -mt-16">
            <h3 class="text-2xl font-bold text-text-primary mb-1">Daniele Pauli</h3>
            <p class="text-orange font-medium mb-4">Coach für Körper, Kopf & Lebenskraft</p>
            <p class="text-text-secondary text-sm italic">
              "Ich verbinde zwei Jahrzehnte Coaching-Erfahrung mit einem einfachen Ziel:
              dass du ab 40 wieder zu Energie, Kraft und Klarheit findest, ohne dein Leben auf den Kopf zu stellen."
            </p>
          </div>
        </div>

        <!-- Zweites Foto: Seminar, versetzt -->
        <div class="hidden sm:block absolute -bottom-8 -right-4 lg:-right-8 w-44 lg:w-56 rotate-3 rounded-2xl overflow-hidden border border-glass-border shadow-2xl shadow-stone-900/20">
          <img
            src="/images/daniele-seminar.webp"
            alt="Daniele Pauli beim Seminar zur Kraftmaximierung"
            class="w-full aspect-[4/3] object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
